<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Liquid Glass icon from icon/PomoSupervisor.icon, compiled into Resources/Assets.car -->
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <!-- The UI follows the system language; permission prompts come from l10n/*.lproj/InfoPlist.strings. -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>en</string>
    <string>en_AU</string>
    <string>zh-Hans</string>
    <string>zh-Hant</string>
    <string>ja</string>
  </array>
  <key>CFBundleIconName</key>
  <string>PomoSupervisor</string>
  <key>NSAppleEventsUsageDescription</key>
  <string>PomoSupervisor reads the address of the browser’s current tab to tell whether you’re focused.</string>
  <key>NSScreenCaptureUsageDescription</key>
  <string>PomoSupervisor reads window titles, and takes screenshots when vision checks are on.</string>
</dict>
</plist>
