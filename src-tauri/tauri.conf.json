{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PomoSupervisor",
  "version": "0.1.0",
  "identifier": "dev.aoba.pomosupervisor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PomoSupervisor",
        "url": "index.html",
        "width": 320,
        "height": 440,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "infoPlist": "Info.plist",
      "minimumSystemVersion": "12.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car",
        "Resources/en.lproj/InfoPlist.strings": "l10n/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "l10n/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "l10n/zh-Hant.lproj/InfoPlist.strings",
        "Resources/ja.lproj/InfoPlist.strings": "l10n/ja.lproj/InfoPlist.strings"
      }
    }
  }
}
